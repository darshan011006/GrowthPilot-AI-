# GrowthPilot AI configuration. Copy to .env with `make env` (fills in fresh secret keys).
# Never commit .env. Leave a value empty if you don't have it yet; the app tells you what's missing.

# ── Mode ────────────────────────────────────────────────────────────────
# demo: fictional brand, labelled fixtures, mock Instagram adapter, synthetic metrics. No external calls.
# live: real LLM, real research, real Instagram. Real data only.
APP_MODE=demo
# development | test | production
APP_ENV=development

# Database. Defaults to data/demo.db or data/live.db by mode. PostgreSQL also works:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/growthpilot
# A database is bound to the mode that first used it; the app refuses to open it in the other mode.
DATABASE_URL=
# Optional. The job queue is database-backed, so Redis isn't required.
REDIS_URL=

# ── Secrets (required in live mode; auto-generated locally for demo) ────
SECRET_KEY=
# Fernet key that encrypts OAuth tokens and webhook secrets at rest.
ENCRYPTION_KEY=

# Public URL people use to open the app (the frontend). OAuth redirects and public image links use it.
# Must be public HTTPS for Instagram publishing (e.g. a cloudflared/ngrok tunnel during a demo).
BASE_URL=http://localhost:3000

# ── LLM (live mode) ─────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
# Anthropic API key from console.anthropic.com. API usage is billed separately from Claude subscriptions.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# ── Web research (live mode) ────────────────────────────────────────────
# brave | none   — Brave Search API: https://brave.com/search/api/
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# ── Image generation ────────────────────────────────────────────────────
# No provider is implemented yet; the agent writes image briefs and uses labelled placeholders.
IMAGE_GENERATION_PROVIDER=none
IMAGE_GENERATION_API_KEY=

# ── Instagram API with Instagram Login (Meta) ───────────────────────────
# Create an app at developers.facebook.com with the "Instagram API with Instagram Login" product.
META_APP_ID=
META_APP_SECRET=
# Defaults to {BASE_URL}/api/integrations/instagram/callback — register exactly this URL with Meta.
META_REDIRECT_URI=
INSTAGRAM_API_VERSION=v26.0

# ── Safety switches ─────────────────────────────────────────────────────
# Master switch for posting to real accounts. Off by default. Even when on, each post needs owner approval,
# explicit publish authorisation for that version, and a confirmation when scheduling.
LIVE_PUBLISHING_ENABLED=false
# Webhook adapter: allow http:// and private targets (local testing only).
ALLOW_INSECURE_WEBHOOKS=false

# ── Worker ──────────────────────────────────────────────────────────────
RUN_WORKER_IN_PROCESS=true
WORKER_INTERVAL_SECONDS=10
