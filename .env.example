# GrowthPilot AI configuration. Copy to .env with `make env` (fills in fresh secret keys).
# Never commit .env. Leave a value empty if you don't have it yet; the app tells you what's missing.
# Consumer subscriptions (ChatGPT Plus, Gemini app, Canva, Adobe Express) do NOT include API access or credits.

# ── Mode ────────────────────────────────────────────────────────────────
# demo: Poojaloka catalogue snapshot (real, dated) + labelled fixtures, simulated adapters for all seven
#       platforms, synthetic metrics. No external calls and no paid calls.
# live: real LLM, real research, real platform adapters, real data only.
APP_MODE=demo
# development | test | production
APP_ENV=development

# Database. Defaults to data/demo.db or data/live.db by mode. PostgreSQL also works:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/growthpilot
# A database is bound to the mode that first used it; the app refuses to open it in the other mode.
DATABASE_URL=
# Optional. The job queue is database-backed, so Redis isn't required.
REDIS_URL=
# Where images are stored (defaults to data/assets-<mode>). Use a persistent volume in production.
ASSET_DIR=

# ── Secrets (required in live mode; auto-generated locally for demo) ────
SECRET_KEY=
# Fernet key that encrypts OAuth tokens and webhook secrets at rest.
ENCRYPTION_KEY=

# Public URL people use to open the app (the frontend). OAuth redirects and public image links use it.
# Must be public HTTPS for Instagram/Facebook publishing (e.g. a cloudflared/ngrok tunnel during a demo).
BASE_URL=http://localhost:3000

# ── LLM (live mode) ─────────────────────────────────────────────────────
# auto = Groq if GROQ_API_KEY is set, then Gemini (GEMINI_API_KEY), then Claude (LLM_API_KEY).
# Or force groq | gemini | anthropic.
LLM_PROVIDER=auto
# Groq API key from https://console.groq.com/keys (limits apply per organisation, not per key).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# free | developer. Free records $0 cost (tokens are still counted); developer uses on-demand prices.
GROQ_TIER=free
# low | medium | high (gpt-oss reasoning; low keeps runs inside the free tier's tokens per minute)
GROQ_REASONING_EFFORT=low
# How live runs pick tools. model = the LLM chooses each step; rules = the fixed step plan with the LLM writing
# the text (about ten times fewer tokens); auto = rules on Groq's free tier, model otherwise.
AGENT_PLANNER=auto
# Google Gemini API key from https://aistudio.google.com/apikey (paid usage is billed by Google; some models
# have a free tier with lower rate limits).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# minimal | low | medium | high (support varies by model)
GEMINI_THINKING_LEVEL=medium
# Anthropic API key from console.anthropic.com (optional; billed separately from Claude subscriptions).
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# ── Web research (live mode) ────────────────────────────────────────────
# Brave Search API: https://brave.com/search/api/ — $5 per 1,000 requests after a monthly credit (2026-10-24).
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# Identical searches are served from the database cache for this many hours.
SEARCH_CACHE_HOURS=24
# Seconds before a Brave request is abandoned.
SEARCH_TIMEOUT_SECONDS=15
# Brave's terms let you keep API results only on plans with storage rights. Leave false unless your plan has them:
# campaign research then keeps titles and URLs, and drops the snippets once the strategy has used them.
# (SEARCH_CACHE_HOURS also stores results; set it to 0 if your plan has no storage rights.)
BRAVE_STORAGE_RIGHTS=false

# ── Image generation (optional) ─────────────────────────────────────────
# Posters always render locally for free. An image model can add an abstract background (labelled on the image);
# product imagery is always a real photo. none | gemini (uses GEMINI_API_KEY unless a separate key is set).
IMAGE_GENERATION_PROVIDER=none
IMAGE_GENERATION_MODEL=gemini-3.1-flash-lite-image
IMAGE_GENERATION_API_KEY=

# ── Campaign generation (research → strategy → captions → one image per day) ───────
# Images use CAMPAIGN_IMAGE_MODEL only when IMAGE_GENERATION_PROVIDER=gemini; otherwise the local poster renderer
# is used and the app says so. The AI makes the background scene only; real product photos and the text are
# added by the renderer. "Nano Banana 2.1" = gemini-nano-banana-2.1 (checked 2026-11-01 in Google's docs): 1K
# $0.0336, 2K $0.0504, 4K $0.113 per image, and no free tier for image output (billing must be on).
CAMPAIGN_IMAGE_MODEL=gemini-nano-banana-2.1
# 1K | 2K | 4K (uppercase K)
CAMPAIGN_IMAGE_SIZE=2K
# Brave searches for one whole campaign (never per day; never repeated when a day's image is regenerated).
CAMPAIGN_MAX_SEARCHES=5
# Automatic image tries per day before the day is marked failed (each try is one billable request).
CAMPAIGN_IMAGE_ATTEMPTS=2
# Image requests in flight at once. Days are generated one after another.
CAMPAIGN_IMAGE_CONCURRENCY=1
# Per generated campaign, in USD. Checked before the campaign starts and before every paid call.
CAMPAIGN_BUDGET_USD=1.00
# Seconds before one image request is abandoned.
IMAGE_TIMEOUT_SECONDS=120

# ── Catalogue (Poojaloka storefront) ────────────────────────────────────
POOJALOKA_API_BASE=https://api.poojaloka.com/api
# Demo mode uses the bundled snapshot. true = allow "Sync" to fetch the live public store in demo mode.
DEMO_ALLOW_CATALOGUE_SYNC=false
# Prices older than this are flagged; live mode refuses to publish a stale price.
CATALOGUE_FRESH_HOURS=24

# ── Instagram Login and Facebook Pages ─────────────────────────────────
# Direct Instagram Login credentials, when enabled for the app.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta Login for Business credentials; required for Facebook Pages and Unified Instagram Login.
META_APP_ID=
META_APP_SECRET=
# Unified Login configuration ID from the Instagram API use case.
META_LOGIN_CONFIG_ID=
# Defaults to {BASE_URL}/api/integrations/instagram/callback
META_REDIRECT_URI=
INSTAGRAM_API_VERSION=v26.0
# Defaults to {BASE_URL}/api/integrations/facebook/callback
FACEBOOK_REDIRECT_URI=
FACEBOOK_API_VERSION=v26.0

# ── Safety switches ─────────────────────────────────────────────────────
# Master switch for posting to real accounts. Off by default and forced off in demo. Even when on, each post needs
# owner approval of the exact version and images, explicit publish authorisation, and a confirmation when scheduling.
LIVE_PUBLISHING_ENABLED=false
# Webhook adapter: allow http:// and private targets (local testing only).
ALLOW_INSECURE_WEBHOOKS=false

# ── Worker ──────────────────────────────────────────────────────────────
RUN_WORKER_IN_PROCESS=true
WORKER_INTERVAL_SECONDS=10
